# OpenAI 或 OpenAI 兼容服务的 API Key
LLM_API_KEY=your_api_key_here

# 模型名称，请按你的服务商实际支持的模型填写
LLM_MODEL=your_model_name_here

# 官方 OpenAI 可留空。
# 若使用兼容 OpenAI API 的服务，请填写对应 Base URL。
LLM_BASE_URL=

# Planner、Query Rewrite 等模型调用配置
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Tavily 网页搜索 API Key
TAVILY_API_KEY=tvly-your_tavily_key_here

# 每次网页搜索最多返回几条结果
TAVILY_MAX_RESULTS=5

# Tavily 检索结果在 Redis 中的缓存时间，单位为秒
SEARCH_CACHE_TTL_SECONDS=3600
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TIME_LIMIT_SECONDS=600
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=540